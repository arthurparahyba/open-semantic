{
  "name": "open-semantic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @open-semantic/desktop dev",
    "start": "pnpm --filter @open-semantic/desktop start",
    "test:e2e": "pnpm --filter @open-semantic/desktop test:e2e",
    "gen:types": "node scripts/gen-types.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate:contracts": "python3 contracts/validar.py",
    "lint": "oxlint --deny-warnings",
    "guardrails": "node scripts/check-boundaries.mjs && node scripts/metrics.mjs --check",
    "metrics": "node scripts/metrics.mjs",
    "metrics:baseline": "node scripts/metrics.mjs --update-baseline"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "1.86.0",
    "rolldown": "1.2.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
