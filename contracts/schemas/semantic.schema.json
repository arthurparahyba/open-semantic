{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.open-semantic.invalid/v0.2/semantic.schema.json",
  "title": "Open Semantic V0.2 — entidades, relações e evidências",
  "description": "Decisão provisória D2: o Open Semantic é uma camada lógica atrás da interface SemanticStore. Estes schemas descrevem o modelo lógico e o formato de exportação, não o formato de armazenamento.",
  "$defs": {
    "EntityKind": {
      "description": "Vocabulário inicial. Valores fora da lista são aceitos com prefixo 'x-' para extensão.",
      "anyOf": [
        { "enum": ["application", "module", "service", "component", "api", "endpoint", "data_store", "file", "directory", "process", "concept", "decision", "requirement"] },
        { "type": "string", "pattern": "^x-[a-z][a-z0-9_]*$" }
      ]
    },
    "RelationType": {
      "anyOf": [
        { "enum": ["contains", "implements", "depends_on", "calls", "communicates_with", "reads", "writes", "exposes", "tests", "documents", "decided_by", "represents"] },
        { "type": "string", "pattern": "^x-[a-z][a-z0-9_]*$" }
      ]
    },

    "Evidence": {
      "description": "Uma observação concreta que sustenta entidades ou relações. Evidências são imutáveis; quando o artefato muda, a evidência fica stale, não é editada.",
      "type": "object",
      "required": ["id", "kind", "observedAt", "summary", "status"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/EvidenceId" },
        "kind": { "enum": ["file_inspection", "directory_listing", "command_execution", "user_statement", "agent_reasoning", "diagram_edit"] },
        "artifactId": { "$ref": "common.schema.json#/$defs/ArtifactId" },
        "span": {
          "type": "object",
          "required": ["lineStart", "lineEnd"],
          "properties": {
            "lineStart": { "type": "integer", "minimum": 1 },
            "lineEnd": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "artifactFingerprint": { "$ref": "project.schema.json#/$defs/Fingerprint" },
        "operationId": { "$ref": "common.schema.json#/$defs/OperationId" },
        "turnId": { "$ref": "common.schema.json#/$defs/TurnId" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "status": { "enum": ["current", "stale"] },
        "observedAt": { "$ref": "common.schema.json#/$defs/Timestamp" }
      },
      "additionalProperties": false
    },

    "SemanticEntity": {
      "type": "object",
      "required": ["id", "kind", "name", "status", "provenance", "revision"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/SemanticEntityId" },
        "kind": { "$ref": "#/$defs/EntityKind" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "projectId": { "$ref": "common.schema.json#/$defs/ProjectId" },
        "artifactIds": {
          "description": "Recursos reais que materializam a entidade. Um arquivo é uma entidade 'file' com exatamente um artifactId.",
          "type": "array", "items": { "$ref": "common.schema.json#/$defs/ArtifactId" }, "uniqueItems": true
        },
        "attributes": { "type": "object" },
        "status": { "$ref": "common.schema.json#/$defs/KnowledgeStatus" },
        "provenance": { "$ref": "common.schema.json#/$defs/Provenance" },
        "revision": { "$ref": "common.schema.json#/$defs/Revision" }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/$defs/KnowledgeRules" } ]
    },

    "SemanticRelation": {
      "type": "object",
      "required": ["id", "type", "sourceId", "targetId", "status", "provenance", "revision"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/RelationId" },
        "type": { "$ref": "#/$defs/RelationType" },
        "sourceId": { "$ref": "common.schema.json#/$defs/SemanticEntityId" },
        "targetId": { "$ref": "common.schema.json#/$defs/SemanticEntityId" },
        "attributes": { "type": "object" },
        "status": { "$ref": "common.schema.json#/$defs/KnowledgeStatus" },
        "provenance": { "$ref": "common.schema.json#/$defs/Provenance" },
        "revision": { "$ref": "common.schema.json#/$defs/Revision" }
      },
      "additionalProperties": false,
      "allOf": [ { "$ref": "#/$defs/KnowledgeRules" } ]
    },

    "KnowledgeRules": {
      "description": "Regra central do Open Semantic: inferência do agente nunca é 'verified' sem evidência (V0.1 §3.4, critério C3).",
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "source": { "enum": ["inspection", "execution", "user_statement", "diagram_edit", "import"] },
                  "evidenceIds": { "minItems": 1 }
                },
                "required": ["evidenceIds"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "provenance": { "properties": { "source": { "const": "agent_inference" } }, "required": ["source"] } },
            "required": ["provenance"]
          },
          "then": { "properties": { "status": { "enum": ["inferred", "pending", "stale", "invalid", "rejected"] } } }
        }
      ]
    }
  }
}
